# Local credential only. Never commit a real value.
HY3_API_KEY=your_openrouter_api_key
HY3_BASE_URL=https://openrouter.ai/api/v1
HY3_MODEL=tencent/hy3

# Optional local/GPU Qwen3-TTS realization layer.
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_DEVICE=cuda:0
QWEN3_TTS_DTYPE=bfloat16
# Optional when flash-attn is separately installed:
# QWEN3_TTS_ATTN=flash_attention_2
