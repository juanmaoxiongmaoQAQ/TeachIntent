# Local credential only. Never commit a real value.
HY3_API_KEY=
HY3_BASE_URL=https://openrouter.ai/api/v1
HY3_MODEL=tencent/hy3

# Local Judge credential for optional live Evaluator v0.1 in the web app.
# You may set this to the same OpenRouter key as HY3_API_KEY.
OPENROUTER_API_KEY=

# Optional BatonVoice reference renderer. Supply EXISTING local paths only.
# Leaving these empty keeps speech rendering unavailable; Explore/planning still work.
BATONVOICE_MODEL_PATH=
BATONVOICE_COSYVOICE_MODEL_DIR=
BATONVOICE_SOURCE_DIR=
BATONVOICE_WETEXT_FST_DIR=
BATONVOICE_PROMPT_AUDIO_PATH=
BATONVOICE_TENSOR_PARALLEL_SIZE=1
BATONVOICE_GPU_MEMORY_UTILIZATION=0.25
BATONVOICE_FP16=0
# Preserve the previously validated reference condition; no tuning is implied.
BATONVOICE_SPEECH_SPEED=0.85
# Single-pass Web outputs: relative to TeachIntent; project-external paths rejected.
TEACHINTENT_BATONVOICE_OUTPUT_DIR=outputs

# Optional local/GPU Qwen3-TTS realization layer.
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_DEVICE=cuda:0
QWEN3_TTS_DTYPE=bfloat16
# Optional when flash-attn is separately installed:
# QWEN3_TTS_ATTN=flash_attention_2
